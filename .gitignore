htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# JupyterBook / MyST build output
_build/

# Figure build intermediates (rendered output in media/figures is committed)
figures/build/

# Artifacts written into the source tree by notebook execution. Found by the
# W1 audit 2026-08-18: running the book emits ~13 of these. They are generated
# output, not source, and must not be committed.
notebooks/*-dev/*.gms
notebooks/*-dev/sudoku_puzzles_*.csv
# ^ stale-location guard only. Since 2026-08-25 the sudoku puzzles are COMMITTED
# course data in notebooks/data/ (regenerated by scripts/generate_sudoku_puzzles.py),
# which this pattern deliberately does not match.
notebooks/5-dev/example_reactor_compute_FIM_*.png
notebooks/5-dev/data/

# Custom MyST theme (see DEVELOPER.md).
#
# vendor/myst-theme  -- git-subtree source of truth, committed.
# themes/*-dist      -- packaged artifact myst.yml consumes, committed.
#
# But NOT their node_modules. `myst build` runs npm install inside the packaged
# theme on first use, which creates a 29 MB tree there. It is regenerated on
# demand and must never be committed.
node_modules/
vendor/myst-theme/node_modules/
themes/pyomo-book-theme-dist/node_modules/

# macOS Finder metadata.
.DS_Store
**/.DS_Store

# Microsoft Office lock files. Excel writes "~$<name>.xlsx" beside an open
# workbook and deletes it on close, so one appears and disappears depending on
# whether the workbook happens to be open. This repo tracks
# notebooks/data/knapsack_data.xlsx, so it can produce one. Transient artifact,
# never content. Added 2026-08-28 after the sibling private repo produced one.
~$*.xlsx
~$*.docx
~$*.pptx
