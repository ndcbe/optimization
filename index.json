near programming, deterministic global optimization, integer programming, dynamic optimization, and stochastic programming. Multi-objective optimization, optimization with embedded machine learning models as constraints, optimal experiment design, optimization for statistical inference, and mathematical programs with complementarity constraints may be covered based on time and student interests. The class is designed for advanced undergraduate/graduate engineering, science, mathematics, business, and statistics students who wish to incorporate computation optimization methods into their research. The course begins with an introduction to modeling and the Python-based Pyomo computational environment. Optimization theory and algorithms are emphasized throughout the semester.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"SdN3v8Ir5S"}],"key":"JMoTB5tI4y"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"What am I going to get out of this class?","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"eHeA46F8aR"}],"identifier":"what-am-i-going-to-get-out-of-this-class","label":"What am I going to get out of this class?","html_id":"what-am-i-going-to-get-out-of-this-class","implicit":true,"key":"CoarZtNwpr"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"At the end of the semester, you should be able to...","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"BHGSurO2Ow"}],"key":"z6enRGBqpm"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":10,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Mathematically formulate optimization 