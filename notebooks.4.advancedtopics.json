value":"# Install course dependencies before importing Pyomo on Colab.\nimport sys\n\nif \"google.colab\" in sys.modules:\n    !wget \"https://raw.githubusercontent.com/ndcbe/optimization/main/notebooks/helper.py\"\n    import helper\n\n    helper.easy_install()\nelse:\n    sys.path.insert(0, \"../\")\n    import helper\n\nhelper.set_plotting_style()\n\nimport numpy as np\n\nlower, upper = -1.0, 1.0\n\n\ndef integrand(x):\n    return 7 * x**3 - 8 * x**2 - 3 * x + 3\n\n\n# Odd powers integrate to zero; integrate -8*x**2 + 3 analytically.\nexact = 2 / 3\ntrapezoid = (upper - lower) * (integrand(lower) + integrand(upper)) / 2\n# Two nodes integrate polynomials through degree 3 exactly on [-1, 1].\nnodes, weights = np.polynomial.legendre.leggauss(2)\ngauss_legendre = sum(weights * integrand(nodes))\n\nprint(f\"exact: {exact:.12f}\")\nprint(f\"trapezoid: {trapezoid:.12f}\")\nprint(f\"two-point Gauss--Legendre: {gauss_legendre:.12f}\")\nassert abs(gauss_legendre - exact) < 1e-12","identifier":"8a52f304a1e0-4088a586da3e9a0cea47-code","enumerator":"1","html_id":"id-8a52f304a1e0-4088a586da3e9a0cea47-code","key":"Y0lMSnS46Z"},{"type":"outputs","id":"v4vLFWLeeCC_HepwrtaRi","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"exact: 0.666666666667\ntrapezoid: -10.000000000000\ntwo-point Gauss--Legendre: 0.666666666667\n"},"children":[],"identifier":"8a52f304a1e0-4088a586da3e9a0cea47-outputs-0","html_id":"id-8a52f304a1e0-4088a586da3e9a0cea47-outputs-0","key":"iZPP5RH4pY"}],"identifier":"8a52f304a1e0-4088a586da3e9a0cea47-outputs","html_id":"id-8a52f304a1e0-4088a586da3e9a0cea47-outputs","key":"KYV9Rq9PdQ"}],"identifier":"8a52f304a1e0-4088a586da3e9a0cea47","label":"8a52f304a1e0-4088a586da3e9a0cea47","html_id":"id-8a52f304a1e0-4088a586da3e9a0cea47","key":"PvztBkGmSR"},{"type":"block","kind":"notebook-content","data":{"id":"8a52f304a1e0-18a871a444bc9be3a174"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end"