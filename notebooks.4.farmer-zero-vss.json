ython.display import display\nhelper.set_plotting_style()\n\nfrom farmer import *\n","key":"N2aW1DhUTl"},{"type":"outputs","id":"spFpqVJxThyyNOgch8G5N","children":[],"key":"zFSvLjRPDQ"}],"identifier":"08cdba8b","html_id":"08cdba8b","key":"jXX9BfpM9Y"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-28T03:29:29.012598Z","iopub.status.busy":"2026-09-28T03:29:29.012444Z","iopub.status.idle":"2026-09-28T03:29:29.032059Z","shell.execute_reply":"2026-09-28T03:29:29.031776Z"},"id":"301dada5513c-e809bfcaaba5181e1e33"},"children":[{"type":"code","lang":"python","executable":true,"value":"# Exercise 8 data, p. 19. Purchase prices are 40% above selling prices.\nEX8_PLANT_COST = {\"WHEAT\": 180.0, \"CORN\": 280.0, \"BEETS\": 310.0}\nEX8_SELL_PRICE = {\n    \"WHEAT\": 300.0,\n    \"CORN\": 170.0,\n    \"BEETS_FAVORABLE\": 41.0,\n    \"BEETS_UNFAVORABLE\": 11.0,\n}\n\n\ndef price_scenario(wheat_price, yield_multiplier=1.0):\n    \"\"\"One scenario of Exercise 8: a wheat selling price, optionally with a yield.\"\"\"\n    sell = dict(EX8_SELL_PRICE, WHEAT=wheat_price)\n    return {\n        \"yield\": {c: MEAN_YIELD[c] * yield_multiplier for c in CROPS},\n        \"sell\": sell,\n        \"buy\": {c: 1.4 * sell[c] for c in FEED_CROPS},\n    }\n\n\n# Wait-and-see: what the farmer would do knowing next year's wheat price.\nwait_and_see = {}\nfor price in (300.0, 220.0):\n    m = solve_farmer(build_farmer([price_scenario(price)], plant_cost=EX8_PLANT_COST))\n    wait_and_see[price] = pyo.value(m.expected_profit)\n    p = plan_of(m) + 0.0  # normalize any -0.0 the LP returns\n    print(\n        f\"perfect forecast, wheat at ${price:.0f}/T:\"\n        f\"  acres {p[0]:5.1f} / {p[1]:5.1f} / {p[2]:5.1f}\"\n        f\"   profit ${wait_and_see[price]:,.0f}\"\n    )\n\n# Here-and-now: one plan, both prices, recourse after the price is revealed.\nprice_sp = solve_farmer(\n    build_farmer(\n        [price_scenario(300.0), price_scenario(220.0)], plant_cost=EX8_PLANT_COST\n    )\n)\nprice_plan = plan_of(price_sp)\nrp_price = pyo.value(price_sp.expected_profit)\nws_price = np.mean(list(wait_and_see.values()))\nprint(\n    f\"\\nstochastic plan: acres {price_plan[0]:5.1f} / {price_plan[1]:5.1f}\"\n    f\" / {price_plan[2]:5.1f}   E[profit] ${rp_price:,.0f}\"\n)\nprint(f\"WS   = ${ws_price:,.0f}\")\nprint(f\"RP   = ${rp_price:,.0f}\")\nprint(f\"EVPI = ${ws_price - rp_price:,.0f}   <- Exercise 8's question\")\n\n# EEV: plan at the mean price, then live with both.\nmean_price_model = solve_farmer(\n    build_farmer([price_scenario(260.0)], plant_cost=EX8_PLANT_COST)\n)\neev, _ = grade_plan(\n    plan_of(mean_price_model),\n    [price_scenario(300.0), price_scenario(220.0)],\n    plant_cost=EX8_PLANT_COST,\n)\nprint(f\"EEV  = ${eev:,.0f}\")\nprint(f\"VSS  = ${rp_price - eev:,.0f}\")","key":"dsx7zj9Mp9"},{"type":"outputs","id":"VKNntDGR9-yx_pkuzgP7k","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"perfect forecast, wheat at $300/T:  acres 500.0 /   0.0 /   0.0   profit $167,880\n"},"children":[],"key":"ppZBsKeHdN"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"perfect forecast, wheat at $220/T:  acres 120.0 /  80.0 / 300.0   profit $131,000\n"},"children":[],"key":"Lkk0ITiAuq"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\nstochastic plan: acres 200.0 /   0.0 / 300.0   E[profit] $137,880\nWS   = $149,440\nRP   = $137,880\nEVPI = $11,560   <- Exercise 8's question\n"},"children":[],"key":"Fa1e6LLwn2"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"EEV  = $137,880\nVSS  = $0\n"},"children":[],"key":"SDQVX9SnFC"}],"key":"H1XD9ILLoV"}],"identifier":"d604fc21","html_id":"d604fc21","key":"NcSvVRN3Xb"},{"type":"block","kind":"notebook-content","data":{"id":"301dada5513c-f5ef584a086d0006ba2c"},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"All solutions and why VSS vanishes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SQchxIKHX3"}],"identifier":"all-solutions-and-why-vss-vanishes","label":"All solutions and why VSS vanishes","html_id":"all-solutions-and-why-vss-vanishes","implicit":true,"key":"s5WSYFu6WV"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The mean-price plan is also stochastic-optimal for these data. This does not make perfect information worthless: knowing the low price before planting permits a different acreage allocation. Compare the complete plans and recourse below.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Uur58CeifV"}],"key":"o0LXCnhhc0"}],"identifier":"4d8216fa","html_id":"4d8216fa","key":"qaVXTG06TQ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-28T03:29:29.033029Z","iopub.status.busy":"2026-09-28T03:29:29.032964Z","iopub.status.idle":"2026-09-28T03:29:29.055439Z","shell.execute_reply":"2026-09-28T03:29:29.055100Z"},"id":"301dada5513c-3eeaf49ee44af96d4c95"},"children":[{"type":"code","lang":"python","executable":true,"value":"def rows_of(record):\n    rows=[]\n    for s in record[\"scenarios\"]:\n        rows.append({\"Scenario\":s[\"id\"],\"Probability\":s[\"probability\"],\n            **{\"Buy \"+k:v for k,v in s[\"purchases_tons\"].items()},\n            **{\"Sell \"+k:v for k,v in s[\"sales_tons\"].items()},\"Profit ($)\":s[\"profit\"]})\n    display(pd.Series(record[\"acreage\"],name=\"Acres\").to_frame().round(3))\n    display(pd.DataFrame(rows).round(2))\nprices=[price_scenario(300),price_scenario(220)]\nfor price in [300,220]:\n    print(\"Perfect information: wheat selling price\",price)\n    rows_of(solution_record(solve_farmer(build_farmer([price_scenario(price)],plant_cost=EX8_PLANT_COST))))\nprint(\"Shared stochastic plan\")\nrows_of(solution_record(price_sp))\nprint(\"Expected-value plan evaluated\")\nrows_of(evaluate_solution(plan_of(mean_price_model),prices,plant_cost=EX8_PLANT_COST))\nassert np.isclose(rp_price-eev,0)\nassert ws_price > rp_price\n","key":"HHWjcReMct"},{"type":"outputs","id":"E1WKKovadi9VwF-nYQGbX","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Perfect information: wheat selling price 300\n"},"children":[],"key":"b2hiY3JRgz"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Acres</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>WHEAT</th>\n      <td>500.0</td>\n    </tr>\n    <tr>\n      <th>CORN</th>\n      <td>0.0</td>\n    </tr>\n    <tr>\n      <th>BEETS</th>\n      <td>-0.0</td>\n    </tr>\n  </tbody>\n</table>\n</div>","content_type":"text/html"},"text/plain":{"content":"       Acres\nWHEAT  500.0\nCORN     0.0\nBEETS   -0.0","content_type":"text/plain"}}},"children":[],"key":"cz2ui6Vd0Z"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Scenario</th>\n      <th>Probability</th>\n      <th>Buy WHEAT</th>\n      <th>Buy CORN</th>\n      <th>Sell WHEAT</th>\n