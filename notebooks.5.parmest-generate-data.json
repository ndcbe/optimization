a7061ad856","key":"wWxR0kA0aT"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-22T15:10:12.401417Z","iopub.status.busy":"2026-08-22T15:10:12.401321Z","iopub.status.idle":"2026-08-22T15:10:12.403509Z","shell.execute_reply":"2026-08-22T15:10:12.403114Z"},"id":"a2c6f2379031-115cc63b7ba966bb6b7d"},"children":[{"type":"code","lang":"python","executable":true,"value":"def kinetics(A, E, T):\n    \"\"\"Computes kinetics from Arrhenius equation\n\n    Arguments:\n        A: pre-exponential factor, [1 / hr]\n        E: activation energy, [kJ / mol]\n        T: temperature, [K]\n\n    Returns:\n        k: reaction rate coefficient, [1 / hr]\n\n    \"\"\"\n    R = 8.31446261815324  # J / K / mole\n\n    return A * np.exp(-E * 1000 / (R * T))\n\n\ndef concentrations(t, k, CA0):\n    \"\"\"\n    Returns concentrations at time t\n\n    Arguments:\n        t: time, [hr]\n        k: reaction rate coefficient, [1 / hr]\n        CA0: initial concentration of A, [mol / L]\n\n    Returns:\n        CA, CB, CC: concentrations of A, B, and C at time t, [mol / L]\n    \"\"\"\n    CA = CA0 * np.exp(-k[0] * t)\n    CB = k[0] * CA0 / (k[1] - k[0]) * (np.exp(-k[0] * t) - np.exp(-k[1] * t))\n    CC = CA0 - CA - CB\n\n    return CA, CB, CC","identifier":"a2c6f2379031-115cc63b7ba966bb6b7d-code","enumerator":"2","html_id":"a2c6f2379031-115cc63b7ba966bb6b7d-code","key":"TF6qDDJMHQ"},{"type":"outputs","id":"CbwTVm481zMR8_fajZ-jE","children":[],"identifier":"a2c6f2379031-115cc63b7ba966bb6b7d-outputs","html_id":"a2c6f2379031-115cc63b7ba966bb6b7d-outputs","key":"otE6NWbXH2"}],"identifier":"a2c6f2379031-115cc63b7ba966bb6b7d","label":"a2c6f2379031-115cc63b7ba966bb6b7d","html_id":"a2c6f2379031-115cc63b7ba966bb6b7d","key":"SErDjBQzkG"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-22T15:10:12.404807Z","iopub.status.busy":"2026-08-22T15:10:12.404729Z","iopub.status.idle":"2026-08-22T15:10:12.533185Z","shell.execute_reply":"2026-08-22T15:10:12.532806Z"},"id":"a2c6f2379031-fe5cfc811b3cac3497a8"},"children":[{"type":"code","lang":"python","executable":true,"value":"CA0 = 1  # Moles/L\nk = [3, 0.7]  # 1/hr\n\nt = np.linspace(0, 1, 51)\nCA, CB, CC = concentrations(t, k, CA0)\nplt.plot(t, CA, label=\"$C_{A}$\", linestyle=\"-\", color=\"blue\")\nplt.plot(t, CB, label=\"$C_{B}$\", linestyle=\"-.\", color=\"green\")\nplt.plot(t, CC, label=\"$C_{C}$\", linestyle=\"--\", color=\"red\")\nplt.xlabel(\"Time [hours]\")\nplt.ylabel(\"Concentration [mol/L]\")\nplt.title(\"Batch Reactor Model\")\nplt.legend()\nplt.show()","identifier":"a2c6f2379031-fe5cfc811b3cac3497a8-code","enumerator":"3","html_id":"a2c6f2379031-fe5cfc811b3cac3497a8-code","key":"R02mtVNuNv"},{"type":"outputs","id":"tMjyLfLfZaJKZlqLEwOty","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b4b238aa6a21ebaf7f2ae0e1504c582a","path":"/optimization/build/b4b238aa6a21ebaf7f2ae0e1504c582a.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"identifier":"a2c6f2379031-fe5cfc811b3cac3497a8-outputs-0","html_id":"a2c6f2379031-fe5cfc811b3cac3497a8-outputs-0","key":"TddyKpk9GA"}],"identifier":"a2c6f2379031-fe5cfc811b3cac3497a8-outputs","html_id":"a2c6f2379031-fe5cfc811b3cac3497a8-outputs","key":"n7XDiY81Gj"}],"identifier":"a2c6f2379031-fe5cfc811b3cac3497a8","label":"a2c6f2379031-fe5cfc811b3cac3497a8","html_id":"a2c6f2379031-fe5cfc811b3cac3497a8","key":"UhhZUobdME"},{"type":"block","kind":"notebook-content","data":{"id":"a2c6f2379031-25608ec15c643079082d"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simulating experimental data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KwPu4OoF3l"}],"identifier":"simulating-experimental-data","label":"Simulating experimental