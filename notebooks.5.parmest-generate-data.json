rd mathnormal\" style=\"margin-right:0.05764em;\">E</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3011em;\"><span style=\"top:-2.55em;margin-left:-0.0576em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"Cu9lHlc1xK"},{"type":"text","value":". See the parmest tutorial notebook for a full description of the mathematical model.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"y8jQ1td3Cy"}],"key":"jNljLGtrvR"}],"key":"VRFUKQe03q"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-22T15:10:12.401417Z","iopub.status.busy":"2026-08-22T15:10:12.401321Z","iopub.status.idle":"2026-08-22T15:10:12.403509Z","shell.execute_reply":"2026-08-22T15:10:12.403114Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def kinetics(A, E, T):\n    \"\"\"Computes kinetics from Arrhenius equation\n\n    Arguments:\n        A: pre-exponential factor, [1 / hr]\n        E: activation energy, [kJ / mol]\n        T: temperature, [K]\n\n    Returns:\n        k: reaction rate coefficient, [1 / hr]\n\n    \"\"\"\n    R = 8.31446261815324  # J / K / mole\n\n    return A * np.exp(-E * 1000 / (R * T))\n\n\ndef concentrations(t, k, CA0):\n    \"\"\"\n    Returns concentrations at time t\n\n    Arguments:\n        t: time, [hr]\n        k: reaction rate coefficient, [1 / hr]\n        CA0: initial concentration of A, [mol / L]\n\n    Returns:\n        CA, CB, CC: concentrations of A, B, and C at time t, [mol / L]\n    \"\"\"\n    CA = CA0 * np.exp(-k[0] * t)\n    CB = k[0] * CA0 / (k[1] - k[0]) * (np.exp(-k[0] * t) - np.exp(-k[1] * t))\n    CC = CA0 - CA - CB\n\n    return CA, CB, CC","key":"nsBzBaNltd"},{"type":"outputs","id":"-_sB57zpcmPmcUddNoJcC","children":[],"key":"ga2etK0xvC"}],"key":"iJXM5qTIZ2"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-22T15:10:12.404807Z","iopub.status.busy":"2026-08-22T15:10:12.404729Z","iopub.status.idle":"2026-08-22T15:10:12.533185Z","shell.execute_reply":"2026-08-22T15:10:12.532806Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"CA0 = 1  # Moles/L\nk = [3, 0.7]  # 1/hr\n\nt = np.linspace(0, 1, 51)\nCA, CB, CC = concentrations(t, k, CA0)\nplt.plot(t, CA, label=\"$C_{A}$\", linestyle=\"-\", color=\"blue\")\nplt.plot(t, CB, label=\"$C_{B}$\", linestyle=\"-.\", color=\"green\")\nplt.plot(t, CC, label=\"$C_{C}$\", linestyle=\"--\", color=\"red\")\nplt.xlabel(\"Time [hours]\")\nplt.ylabel(\"Concentration [mol/L]\")\nplt.title(\"Batch Reactor Model\")\nplt.legend()\nplt.show()","key":"AJKM9dvUnm"},{"type":"outputs","id":"AHJO9OTEEVFEXiI_PApiz","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b4b238aa6a21ebaf7f2ae0e1504c582a","path":"/optimization/build/b4b238aa6a21ebaf7f2ae0e1504c582a.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"oZAv2sDZ3t"}],"key":"KYzsNabj6A"}],"key":"Ku4oRAQnP4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simulating experimental data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R3qpjvyfOy"}],"identifier":"simulating-experimental-data","label":"Simulating experimental data","html_id":"simulating-experimental-data","implicit":true,"key":"KFjr7aJWrn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":