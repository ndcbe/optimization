i></msub></mrow><annotation encoding=\"application/x-tex\">C_C</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8333em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.07153em;\">C</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3283em;\"><span style=\"top:-2.55em;margin-left:-0.0715em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.07153em;\">C</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"m8fax1fLbT"},{"type":"text","value":" at times 0.0, 0.125, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875, and 1.0 hours. These experiments are subject to measurement uncertainty.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"dtDv7UiZyc"}],"key":"nZs8cqHBO7"}],"key":"jZff4L2F4s"}],"key":"wR2ojl0AdK"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Below is Python code to generate data for these simulated experiments.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"z7KWgg7GMR"}],"key":"AgproK4Xjv"}],"key":"krE1euXW4T"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-22T15:10:12.551075Z","iopub.status.busy":"2026-08-22T15:10:12.550967Z","iopub.status.idle":"2026-08-22T15:10:12.555331Z","shell.execute_reply":"2026-08-22T15:10:12.554950Z"},"id":"a2c6f2379031-f0bdb097d3105d1aa17d"},"children":[{"type":"code","lang":"python","executable":true,"value":"## General setup\n\n# declare \"true\" model parameters\nA = np.array([200, 400])  # 1/hr\nE = np.array([10, 15])  # kJ/mol\n\n# declare time for parameter estimation\nt_est = np.array([0.0, 0.125, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875, 1.0])\nn = len(t_est)\n\n# declare measurement uncertainty\nstdev_m_error = 0.1\n\n\n# define function to plot\ndef plot_exp(k, CA0, data, text):\n    \"\"\"\n    Plot concentration profiles\n    Arguments:\n        k: kinetic parameters\n        CA0: initial concentration\n        data: Pandas data frame\n        text: plot title\n\n    \"\"\"\n    # evaluate models\n    t = np.linspace(0, 1, 51)\n    CA, CB, CC = concentrations(t, k, CA0)\n\n    # plot model-generated and 'experimental' data\n    # symbols for 'experimental' data\n    # solid and dashed lines for model-generated data\n    plt.plot(t, CA, label=\"$C_{A}$\", linestyle=\"-\", color=\"blue\")\n    plt.plot(data.time, data.CA, marker=\"o\", linestyle=\"\", color=\"blue\", label=str())\n    plt.plot(t, CB, label=\"$C_{B}$\", linestyle=\"-.\", color=\"green\")\n    plt.plot(data.time, data.CB, marker=\"s\", linestyle=\"\", color=\"green\", label=str())\n    plt.plot(t, CC, label=\"$C_{C}$\", linestyle=\"--\", color=\"red\")\n    plt.plot(data.time, data.CC, marker=\"^\", linestyle=\"\", color=\"red\", label=str())\n    plt.xlabel(\"Time [hours]\")\n    plt.ylabel(\"Concentration [mol/L]\")\n    plt.title(text)\n    plt.legend()\n    plt.show()\n\n\n# define function to accept set of T and C_A0 values as input and generate true parameters and data with noise\ndef gen_data(T_vals, CA0_vals, t_est, std_error, n):\n    \"\"\"\n    function to accept set of T and C_A0 values as input and generate and store data with noise to csv files\n    Arguments:\n        T_vals: list of temperature, K\n        CA0_vals: list of inlet concentrations of A, mol/L\n        t_est: time steps for experiment, hrs\n        std_error: uncertainty added to data\n        n: number of data points = length of t_est\n    Return:\n        filename_list: list of filenames\n    \"\"\"\n    filename_list = []\n    # experiment number counter\n    counter = 0\n    for T in T_vals:\n        for CA0 in CA0_vals:\n            counter += 1\n            # define \"true\" kinetic parameters at this temperature\n            k = kinetics(A, E, T)\n\n            # evaluate model to generate data\n            CA_exp, CB_exp, CC_exp = concentrations(t_est, k, CA0)\n\n            # add measurement error\n            # Note: adding random errors to concentration can result in negative concentrations\n            # To ensure the data seems realistic, we need to ignore negative concentration data points\n\n            CA_exp += np.random.normal(0, std_error, n)\n            CB_exp += np.random.normal(0, std_error, n)\n            CC_exp += np.random.normal(0, std_error, n)\n\n            for i in range(n):\n                if CA_exp[i] < 0.0:\n                    CA_exp[i] = 0.0\n                if CB_exp[i] < 0.0:\n                    CB_exp[i] = 0.0\n                if CC_exp[i] < 0.0:\n                    CC_exp[i] = 0.0\n\n            # store dictionary of 'experimental' data in Pandas dataframe\n            data = pd.DataFrame(\n                {\n                    \"time\": t_est,\n                    \"T\": T,\n                    \"CA0\": CA0,\n                    \"CA\": CA_exp,\n                    \"CB\": CB_exp,\n                    \"CC\": CC_exp,\n                }\n            )\n            # generate filename to store data in\n            file_name = data_dir + \"parmest_20210609_data_exp{}.csv\".format(counter)\n            # store data in csv file segregated by 'experiment' number\n            data.to_csv(file_name)\n            # adding file name to list of file names to be used later to read-in data from the csv files\n            filename_list.append(file_name)\n            # plot model-generated and 'experimental' data\n            # symbols for 'experimental' data\n            # solid and dashed lines for model-generated data\n            plot_exp(\n                k,\n                CA0,\n                data,\n                \"Experiment {}: T = {} K and $C_{}$ = {} mol/L\".format(\n                    counter, T, \"A0\", CA0\n                ),\n            )\n    return filename_list","key":"KPxA4pJOR5"},{"type":"outputs","id":"anKfKjR8JGfpQgYxRy7wD","children":[],"key":"a7bEwPuFmY"}],"key":"lcM89XHi4n"},{"type":"block","kind":"notebook-content","data":{"id":"a2c6f2379031-14cdb358f7f727dbe6a0"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simulate data for multiple experiments","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VUE7dTDzjT"}],"identifier":"simulate-data-for-multiple-experiments","label":"Simulate data for multiple experiments","html_id":"simulate-data-for-multiple-experiments","implicit":true,"key":"XoFXl09zTu"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here, we define lists of temperatures and initial concentrations of A to be used to simulate multiple experimental datasets","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ndXUE2Vm8D"}],"key":"xnPyhTciGW"}],"key":"wSY7IMwRZh"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-22T15:10:12.556837Z","iopub.status.busy":"2026-08-22T15:10:12.556760Z","iopub.status.idle":"2026-08-22T15:10:13.296187Z","shell.execute_reply":"2026-08-22T15:10:13.295792Z"},"id":"a2c6f2379031-959487fa4ac65c6d9047","scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# list of temperatures\nT_vals = [250, 300, 350, 400]  # K\n\n# list of initial concentrations of A\nCA0_vals = [0.5, 1.0, 1.5, 2.0]  # mol/L\n\n# generating 'experimental' data and storing list of filenames to be used to load data later\nfile_list = gen_data(T_vals, CA0_vals, t_est, stdev_m_error, n)\n\n# creating a log file to store file names\nlog_file_name = data_dir + \"parmest_log_file.csv\"\n# create a pandas dataframe to store file names\nfile_list_df = pd.DataFrame.from_dict({\"File name\": file_list})\n# save dataframe as a separate csv file\nfile_list_df.to_csv(log_file_name, index=False)","key":"hRNWWfIIvy"},{"type":"outputs","id":"f80Kl9dETuzjZqSovL7-m","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"7782b83b7cd4a974fe17f86313327a8b","path":"/optimization/build/7782b83b7cd4a974fe17f86313327a8b.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"FKejapFIWL"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"963f75e1dcc7bca79047210a394c1c3b","path":"/optimization/build/963f75e1dcc7bca79047210a394c1c3b.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Cky9LssYf8"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4ec6e6f30901d83884490900d6b1777d","path":"/optimization/build/4ec6e6f30901d83884490900d6b1777d.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"FglHeVp1Nl"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"322834057aa1249a9e104c50783781cd","path":"/optimization/build/322834057aa1249a9e104c50783781cd.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"gvgAsCEqDv"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_typ